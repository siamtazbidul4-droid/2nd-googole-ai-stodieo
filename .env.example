# Server & Runtime
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Database & Authentication
MONGODB_URI=
JWT_SECRET=

# Transactional Email (Resend) — Used strictly for Auth/OTP verification
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateways — bKash Tokenized Checkout
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_IS_SANDBOX=true

# Payment Gateways — SSLCOMMERZ Session v4 (Cards, MFS, Net Banking)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_IS_SANDBOX=true

# Optional Gateways & OAuth Providers
NAGAD_MERCHANT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=